# ---------- Banco de dados ----------
# PostgreSQL (produção recomendada)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/casamento?schema=public"

# ---------- Autenticação (NextAuth) ----------
# Gere um segredo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte"
NEXTAUTH_URL="http://localhost:3000"

# ---------- Admin inicial (usado pelo seed) ----------
ADMIN_EMAIL="noivos@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Maria Mercedez e Henrique"

# ---------- Uploads ----------
# Pasta física onde as imagens e comprovantes são gravados.
# Padrão: <raiz do projeto>/uploads . Em produção (Railway), monte um volume
# persistente nesse caminho (ex.: /app/uploads), senão os arquivos são perdidos
# a cada deploy. As URLs públicas continuam sendo /uploads/...
# UPLOAD_DIR="/app/uploads"

# ---------- E-mail (SMTP) ----------
# OPCIONAL: o SMTP também pode ser configurado pelo painel administrativo
# (Configurações → E-mail). Os valores do painel têm prioridade sobre estes.
# Estas variáveis servem como padrão/fallback.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="Lista de Casamento <seu-email@gmail.com>"

# E-mail que recebe as notificações de confirmação pendente
NOTIFY_EMAIL="noivos@exemplo.com"

# URL pública do site (usada nos links dos e-mails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
